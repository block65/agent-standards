{
	"extends": ["npm:@block65/shared-config/lib/fallow/fallow.jsonc"],
	"entry": [
		"hooks/register.ts",
		"tests/*.test.ts",
		"oxfmt.config.ts",
		"oxlint.config.ts",
		"evals/run.ts",
		"evals/grader/grading.config.ts",
		"evals/grader/plugin.ts",
		"evals/grader/plugin.spec.ts"
	],
	"ignoreDependencies": ["claude-code"],
	"ignorePatterns": [
		"**/.claude/**",
		"evals/fixture/**",
		"evals/tasks/**",
		"evals/.results/**"
	],
	"overrides": [
		{
			"files": ["evals/**"],
			"rules": {
				"complexity-crap": "warn",
				"dev-dependencies-in-production": "off"
			}
		}
	]
}
